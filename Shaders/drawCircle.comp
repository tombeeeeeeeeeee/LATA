
//! #include "basePixel.comp"

uniform ivec2 centerCoords;
uniform float radius;
uniform Pixel pixel;

uniform float timer;

void main() {
	const ivec2 localCoords = getLocalCoords();
	const int index = indexFromCoords(localCoords);
	
	const ivec2 globalCoords = localToGlobalCoords(localCoords);
	if (length(vec2(globalCoords - centerCoords)) <= radius)
	{
		setWrite(index, pixel);
	}
	else
	{
		setWrite(index, getRead(index));
	}
}
