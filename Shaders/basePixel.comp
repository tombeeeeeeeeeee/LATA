
//! #include "gpuPixelRep.glsl"

// TODO: Should these be constants instead
uniform int gridCols;
uniform int gridRows;

uniform ivec2 chunkCoords;

uniform bool readSsboFirst;

const int ssboBindingOffset = 3;

layout(std430, binding = ssboBindingOffset + 1) buffer ChunkSlot1
{
	Pixel chunkData1[];
};

layout(std430, binding = ssboBindingOffset + 2) buffer ChunkSlot2
{
	Pixel chunkData2[];
};

layout(std430, binding = ssboBindingOffset + 3) buffer ChunkSlot3
{
	Pixel chunkData3[];
};

layout(std430, binding = ssboBindingOffset + 4) buffer ChunkSlot4
{
	Pixel chunkData4[];
};

layout(std430, binding = ssboBindingOffset + 5) buffer ChunkSlot5
{
	Pixel chunkData5[];
};

layout(std430, binding = ssboBindingOffset + 6) buffer ChunkSlot6
{
	Pixel chunkData6[];
};

layout(std430, binding = ssboBindingOffset + 7) buffer ChunkSlot7
{
	Pixel chunkData7[];
};

layout(std430, binding = ssboBindingOffset + 8) buffer ChunkSlot8
{
	Pixel chunkData8[];
};

layout(std430, binding = ssboBindingOffset + 9) buffer ChunkSlot9
{
	Pixel chunkData9[];
};

const int nearChunkCount = 8;
// Treat as bools
// 0, not one on that side, 1 is read first, 2 is write first
uniform int nearChunkStatus[nearChunkCount];

const ivec2 nearChunkOffsetCoords[nearChunkCount] =
{
	ivec2(-1, 0),
	ivec2(0, 1),
	ivec2(1, 0),
	ivec2(0, -1),
	ivec2(-1, 1),
	ivec2(1, 1),
	ivec2(-1, -1),
	ivec2(1, -1),
};

int getDataOffset()
{
	return gridCols * gridRows;
}

int getReadIndex(int index, bool chunkReadSsboFirst)
{
	return chunkReadSsboFirst ? index : index + getDataOffset();
}

int getWriteIndex(int index, bool chunkReadSsboFirst)
{
	return chunkReadSsboFirst ? index + getDataOffset() : index;
}

int getReadIndex(int index)
{
	return getReadIndex(index, readSsboFirst);
}

int getWriteIndex(int index)
{
	return getWriteIndex(index, readSsboFirst);
}

Pixel getRead(int index)
{
	return chunkData1[getReadIndex(index)];
}

void setWrite(int index, Pixel pixel)
{
	chunkData1[getWriteIndex(index)] = pixel;
}

void setRead(int index, Pixel pixel)
{
	chunkData1[getReadIndex(index)] = pixel;
}

int indexFromCoords(ivec2 coord)
{
	return (coord.x % gridCols) + (coord.y * gridCols);
}

ivec2 coordsFromIndex(int index)
{
	return ivec2(index % gridCols, index / gridCols);
}

// Assumes that the globalCoords are contained within the chunk
ivec2 globalToLocalCoords(ivec2 globalCoords)
{
	return ivec2(globalCoords.x - (chunkCoords.x * gridCols), globalCoords.y - (chunkCoords.y * gridRows));
}

ivec2 localToGlobalCoords(ivec2 localCoords)
{
	return ivec2(localCoords.x + (chunkCoords.x * gridCols), localCoords.y + (chunkCoords.y * gridRows));
}

ivec2 localToOtherLocalCoords(ivec2 localCoords, ivec2 otherChunkCoords)
{
	return ivec2(localCoords.x + ((chunkCoords.x - otherChunkCoords.x) * gridCols), localCoords.y + ((chunkCoords.y - otherChunkCoords.y) * gridRows));
}

bool containsLocalCoords(const ivec2 localCoords)
{
	return localCoords.x >= 0 && localCoords.x < gridCols && localCoords.y >= 0 && localCoords.y < gridRows;
}

bool containsGlobalCoords(const ivec2 globalCoords)
{
	ivec2 asLocal = globalToLocalCoords(globalCoords);
	return containsLocalCoords(asLocal);
}

ivec2 getLocalCoords()
{
	return ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);
}

// Returns the "direction" of the belonging chunk
// For example: (0, 0) for contained, (-1, 0) for left, (1, 1) for up right
ivec2 getLocalChunkDirection(const ivec2 localCoords)
{
	return ivec2((localCoords.x < 0) ? -1 : ((localCoords.x >= gridCols) ? 1 : 0), (localCoords.y < 0) ? -1 : ((localCoords.y >= gridRows) ? 1 : 0));
}

